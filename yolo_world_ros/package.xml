<?xml version="1.0"?>
<package format="2">
    <name>yolo_world_ros</name>
    <version>0.0.1</version>
    <description>The yolo_world_ros package provides a ROS 1 node to run YOLO-World object
        detection.</description>

    <maintainer email="xiaosq2000@gmail.com">Shuqi Xiao</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>catkin</buildtool_depend>

    <build_depend>dynamic_reconfigure</build_depend>

    <exec_depend>rospy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>vision_msgs</exec_depend>
    <exec_depend>dynamic_reconfigure</exec_depend>
</package>
